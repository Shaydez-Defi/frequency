{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build -w server && npm run build -w client",
  "outputDirectory": "client/dist",
  "functions": {
    "api/[[...all]].ts": { "runtime": "nodejs22.x" }
  },
  "rewrites": [{ "source": "/((?!api/).*)", "destination": "/index.html" }]
}
