# Server
PORT=5000
# Local dev + tests: SQLite file. Production (Vercel): Postgres connection
# string (or POSTGRES_URL, auto-provided by the Vercel Postgres integration).
DATABASE_URL=file:./dev.db
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Google Sign-In (optional - password login works without it)
# Create credentials at console.cloud.google.com -> APIs & Services -> Credentials -> OAuth client ID (Web)
# Authorized redirect URI must match exactly, e.g. http://localhost:5000/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5000/api/auth/google/callback

# Client (Vite - must start with VITE_)
VITE_API_URL=http://localhost:5000/api
